# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.env

# Large binary checkpoint files (ignored by extension; specific files can be
# force-added with git add -f when they need to be tracked)
*.pth
*.ckpt
*.h5
# NOTE: *.pt is intentionally NOT ignored here so that named checkpoint files
# (e.g. resnet18_cifar10_badnets_anp.pt) can be tracked directly.

# Large datasets — never commit raw data
data/datasets/
data/cifar10/

# Serving-comparison shard artifacts: regenerable from
# data/checkpoints/ by scripts/build_shard_manifest.py
data/serving_manifests/

# Raw results (keep in git — immutable record)
# results/raw/ is intentionally NOT ignored

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
